{
  "name": "researchflow/research-platform", "type": "project", "description": "Ethics-first research workflow for 5 IT workstreams",
  "license": "MIT", "require": {
    "php": "^8.2",
    "endroid/qr-code": "^5.0",
    "laravel/framework": "^12.0",
    "laravel/tinker": "^3.0"
  },
  "require-dev": {
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.0",
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {"psr-4": {"App\\":"app/", "Database\\Seeders\\":"database/seeders/"}},
  "autoload-dev": {"psr-4": {"Tests\\":"tests/"}},
  "scripts": {"post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"], "post-root-package-install":["@php -r \"file_exists('.env') || copy('.env.example', '.env');\""], "post-create-project-cmd": ["@php artisan key:generate --ansi"]},
  "config": {"optimize-autoloader":true,"preferred-install":"dist","sort-packages":true}, "minimum-stability":"stable", "prefer-stable":true
}

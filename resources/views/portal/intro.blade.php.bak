    <script>
        let a = document.getElementById('age');

        function upd() {
            let b = a.value === 'minor';
            document.getElementById('minor-note').style.display = b ? 'block' : 'none';
            let g = document.getElementById('guardian');
            if (g) g.style.display = b ? 'block' : 'none'
        }
        a.addEventListener('change', upd);
        upd();
    </script>
